name: Build APK
on:
  push:
    branches: [main]
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Install
        run: |
          sudo apt-get update && sudo apt-get install -y imagemagick
          npm install
      - name: Prepare web files
        run: |
          mkdir -p www
          cp index.html www/
          cp node_modules/xlsx/dist/xlsx.full.min.js www/
          cp node_modules/html2canvas/dist/html2canvas.min.js www/
      - name: Add Android
        run: npx cap add android
      - name: App icon
        run: |
          R=android/app/src/main/res
          declare -A L=([mdpi]=48 [hdpi]=72 [xhdpi]=96 [xxhdpi]=144 [xxxhdpi]=192)
          for d in "${!L[@]}"; do
            s=${L[$d]}; f=$((s*9/4)); i=$((f*61/100))
            mkdir -p $R/mipmap-$d
            convert icon.png -resize ${s}x${s} $R/mipmap-$d/ic_launcher.png
            convert icon.png -resize ${s}x${s} $R/mipmap-$d/ic_launcher_round.png
            convert icon.png -resize ${i}x${i} -background none -gravity center -extent ${f}x${f} $R/mipmap-$d/ic_launcher_foreground.png
          done
          printf '<?xml version="1.0" encoding="utf-8"?>\n<resources>\n<color name="ic_launcher_background">#ECF3FD</color>\n</resources>\n' > $R/values/ic_launcher_background.xml
      - name: Sync
        run: npx cap sync android
      - name: Build
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: camp-app-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
